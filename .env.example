# Telegram Bot Token (получается через @BotFather)
# Telegram Bot Token (obtained via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# URL API Ollama (по умолчанию http://localhost:11434/api)
# Ollama API URL (default is http://localhost:11434/api)
# Если Ollama запущен на другом компьютере, укажите его IP-адрес, например:
# If Ollama is running on another computer, specify its IP address, for example:
# LLM_API_URL=http://192.168.1.100:11434/api
LLM_API_URL=http://localhost:11434/api

# Модель Ollama по умолчанию
# Default Ollama model
# Доступные модели можно посмотреть командой: ollama list
# Available models can be viewed with the command: ollama list
# Или запустив скрипт: python check_ollama.py
# Or by running the script: python check_ollama.py
LLM_MODEL=llama2

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Для отладки используйте DEBUG
# For debugging use DEBUG
# LOG_LEVEL=DEBUG