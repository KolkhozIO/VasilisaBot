# Telegram Bot Token (получается через @BotFather)
# Telegram Bot Token (obtained via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Провайдер LLM (ollama или lmstudio)
# LLM provider (ollama or lmstudio)
LLM_PROVIDER=ollama

# URL API LLM
# LLM API URL
# Для Ollama (по умолчанию http://localhost:11434/api)
# For Ollama (default is http://localhost:11434/api)
# Если Ollama запущен на другом компьютере, укажите его IP-адрес, например:
# If Ollama is running on another computer, specify its IP address, for example:
# LLM_API_URL=http://192.168.1.100:11434/api
#
# Для LM Studio (по умолчанию http://localhost:1234/v1)
# For LM Studio (default is http://localhost:1234/v1)
# Если LM Studio запущен на другом компьютере, укажите его IP-адрес, например:
# If LM Studio is running on another computer, specify its IP address, for example:
# LLM_API_URL=http://192.168.1.100:1234/v1
LLM_API_URL=http://localhost:11434/api

# Модель LLM по умолчанию
# Default LLM model
# Для Ollama: доступные модели можно посмотреть командой: ollama list
# For Ollama: available models can be viewed with the command: ollama list
# Или запустив скрипт: python check_llm.py
# Or by running the script: python check_llm.py
#
# Для LM Studio: имя модели, загруженной в LM Studio
# For LM Studio: name of the model loaded in LM Studio
LLM_MODEL=llama2

# Язык бота (EN - английский, RU - русский)
# Bot language (EN - English, RU - Russian)
BOT_LANGUAGE=EN

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Для отладки используйте DEBUG
# For debugging use DEBUG
# LOG_LEVEL=DEBUG